{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(ninja:*)",
      "Bash(ccache:*)",
      "Bash(./build/:*)",
      "Bash(build/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git lfs:*)",
      "Bash(gh run:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(run-clang-tidy:*)",
      "Bash(git-clang-format:*)",
      "Bash(python3 tools/scripts/:*)",
      "Bash(luau-analyze:*)",
      "Bash(tracy-capture:*)",
      "Bash(tracy-csvexport:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Edit",
      "Write",
      "Read"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/scripts/format-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
