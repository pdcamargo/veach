{
  "$schema": "../../schemas/veach.project.schema.json",
  "name": "veach-lab",
  "script": "scripts/hello.luau",
  "dev_scripts": [
    "scripts/dev/fly_camera.luau"
  ],
  "window": {
    "title": "Veach Lab",
    "width": 1280,
    "height": 720
  },
  "input": {
    "move_up": [
      "e",
      "gamepad_right_shoulder"
    ],
    "move_down": [
      "q",
      "gamepad_left_shoulder"
    ],
    "sprint": [
      "left_shift",
      "right_shift"
    ],
    "mouse_look": [
      "mouse_right"
    ]
  },
  "axes": {
    "move_x": {
      "source": "gamepad_left_x",
      "negative": "a",
      "positive": "d",
      "dead_zone": 0.15
    },
    "move_z": {
      "source": "gamepad_left_y",
      "negative": "s",
      "positive": "w",
      "dead_zone": 0.15
    },
    "turn": {
      "source": "gamepad_right_x",
      "negative": "left",
      "positive": "right",
      "dead_zone": 0.15
    },
    "look": {
      "source": "gamepad_right_y",
      "negative": "down",
      "positive": "up",
      "dead_zone": 0.15
    },
    "look_x": {
      "source": "mouse_x",
      "sensitivity": 0.0025
    },
    "look_y": {
      "source": "mouse_y",
      "sensitivity": 0.0025
    },
    "boost": {
      "source": "gamepad_right_trigger",
      "dead_zone": 0.05
    }
  }
}
