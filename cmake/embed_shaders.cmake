# Generates <NAMESPACE>.hpp/.cpp embedding compiled shaders (docs/adr/0026-shader-compilation.md).
#   LIBRARIES: list of "<stem>|<metallib path or empty>|<reflection json>|<source file, for messages>"
#   ENTRIES:   list of "<stem>|<entry>|<stage>|<dxil path or empty>"
# Both arrive joined with "@@" (see VeachShaders.cmake).

string(REPLACE "@@" ";" LIBRARIES "${LIBRARIES}")
string(REPLACE "@@" ";" ENTRIES "${ENTRIES}")

function(bytes_to_array path out_var)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" length)
    if(length EQUAL 0)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n    " bytes "${bytes}")
    set(${out_var} "${bytes}" PARENT_SCOPE)
endfunction()

# Emits the byte layout of a shader's parameter block (the ConstantBuffer at the push-constant slot) and
# refuses layouts that differ between Metal and HLSL (ADR 0024): 3-component vectors and 3-row/column matrices.
function(parameter_layout reflection_path source stem out_header)
    file(READ "${reflection_path}" json)
    string(JSON parameter_count LENGTH "${json}" parameters)
    set(result "")
    if(parameter_count EQUAL 0)
        set(${out_header} "" PARENT_SCOPE)
        return()
    endif()
    math(EXPR last "${parameter_count} - 1")
    foreach(i RANGE ${last})
        string(JSON kind GET "${json}" parameters ${i} type kind)
        if(NOT kind STREQUAL "constantBuffer")
            continue()
        endif()
        string(JSON struct_name GET "${json}" parameters ${i} type elementType name)
        string(JSON field_count LENGTH "${json}" parameters ${i} type elementType fields)
        set(fields "")
        set(block_size 0)
        math(EXPR last_field "${field_count} - 1")
        foreach(f RANGE ${last_field})
            string(JSON name GET "${json}" parameters ${i} type elementType fields ${f} name)
            string(JSON offset GET "${json}" parameters ${i} type elementType fields ${f} binding offset)
            string(JSON size GET "${json}" parameters ${i} type elementType fields ${f} binding size)
            string(JSON type_kind GET "${json}" parameters ${i} type elementType fields ${f} type kind)
            if(type_kind STREQUAL "vector")
                string(JSON elements GET "${json}" parameters ${i} type elementType fields ${f} type elementCount)
                if(elements EQUAL 3)
                    message(FATAL_ERROR "${source}: '${struct_name}.${name}' is a 3-component vector. Its size differs "
                        "between Metal (16 bytes) and HLSL (12): use a 4-component vector (ADR 0024).")
                endif()
            elseif(type_kind STREQUAL "matrix")
                string(JSON rows GET "${json}" parameters ${i} type elementType fields ${f} type rowCount)
                string(JSON columns GET "${json}" parameters ${i} type elementType fields ${f} type columnCount)
                if(rows EQUAL 3 OR columns EQUAL 3)
                    message(FATAL_ERROR "${source}: '${struct_name}.${name}' is a ${rows}x${columns} matrix. Its layout "
                        "differs between Metal and HLSL: use float4x4 (ADR 0024).")
                endif()
            endif()
            string(APPEND fields "    {\"${name}\", ${offset}, ${size}},\n")
            math(EXPR end "${offset} + ${size}")
            if(end GREATER block_size)
                set(block_size ${end})
            endif()
        endforeach()
        string(APPEND result "/// Byte layout of `${struct_name}` in ${source} (from Slang reflection). Check the C++ mirror with\n")
        string(APPEND result "/// static_assert(veach::rhi::parameters_match<T>(layout::${stem}, {VEACH_PARAM(T, field), ...}));\n")
        string(APPEND result "inline constexpr veach::rhi::ParamField ${stem}_fields[] = {\n${fields}};\n")
        string(APPEND result "inline constexpr veach::rhi::ParamLayout ${stem}{\"${source}\", ${stem}_fields, ${block_size}};\n")
        break()
    endforeach()
    set(${out_header} "${result}" PARENT_SCOPE)
endfunction()

set(header_body "")
set(layout_body "")
set(source_body "")
foreach(library IN LISTS LIBRARIES)
    string(REPLACE "|" ";" parts "${library}")
    list(GET parts 0 stem)
    list(LENGTH parts count)
    set(metallib "")
    if(count GREATER 1)
        list(GET parts 1 metallib)
    endif()
    if(count GREATER 3)
        list(GET parts 2 reflection)
        list(GET parts 3 source_file)
        parameter_layout("${reflection}" "${source_file}" "${stem}" layout)
        string(APPEND layout_body "${layout}")
    endif()

    string(APPEND header_body "/// Compiled from ${stem}.slang.\nconst veach::rhi::ShaderLibrary& ${stem}();\n")

    set(metallib_span "{}")
    if(metallib)
        bytes_to_array("${metallib}" array)
        string(APPEND source_body "alignas(16) constexpr std::uint8_t ${stem}_metallib[] = {\n    ${array}\n};\n")
        set(metallib_span "${stem}_metallib")
    endif()

    set(entry_list "")
    foreach(entry_spec IN LISTS ENTRIES)
        string(REPLACE "|" ";" e "${entry_spec}")
        list(GET e 0 entry_stem)
        if(NOT entry_stem STREQUAL stem)
            continue()
        endif()
        list(GET e 1 entry)
        list(GET e 2 stage)
        list(LENGTH e entry_parts)
        set(dxil "")
        if(entry_parts GREATER 3)
            list(GET e 3 dxil)
        endif()
        set(dxil_span "{}")
        if(dxil)
            bytes_to_array("${dxil}" array)
            string(APPEND source_body "alignas(16) constexpr std::uint8_t ${stem}_${entry}_dxil[] = {\n    ${array}\n};\n")
            set(dxil_span "${stem}_${entry}_dxil")
        endif()
        string(APPEND entry_list
            "    veach::rhi::ShaderEntry{\"${entry}\", veach::rhi::ShaderStage::${stage}, ${dxil_span}},\n")
    endforeach()
    string(APPEND source_body "const veach::rhi::ShaderEntry ${stem}_entries[] = {\n${entry_list}};\n\n")
    string(APPEND source_body "}  // namespace\n\n")
    string(APPEND source_body "const veach::rhi::ShaderLibrary& ${NAMESPACE}::${stem}() {\n")
    string(APPEND source_body "    static const veach::rhi::ShaderLibrary library{\"${stem}\", ${metallib_span}, ${stem}_entries};\n")
    string(APPEND source_body "    return library;\n}\n\nnamespace {\n\n")
endforeach()

file(WRITE "${HEADER}" "// Generated by cmake/embed_shaders.cmake. Do not edit.\n#pragma once\n\n#include <veach/rhi/shader.hpp>\n\nnamespace ${NAMESPACE} {\n\n${header_body}\nnamespace layout {\n\n${layout_body}\n}  // namespace layout\n\n}  // namespace ${NAMESPACE}\n")
file(WRITE "${SOURCE}" "// Generated by cmake/embed_shaders.cmake. Do not edit.\n#include \"${NAMESPACE}.hpp\"\n\n#include <cstdint>\n\n// NOLINTBEGIN\nnamespace {\n\n${source_body}}  // namespace\n// NOLINTEND\n")
