{
  "$id": "veach.project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Veach project file (veach.project.json). Generated by `veach schemas` from reflection.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "frames": {
      "default": 0,
      "type": "integer"
    },
    "headless": {
      "default": false,
      "type": "boolean"
    },
    "log_format": {
      "default": "human",
      "enum": [
        "human",
        "json"
      ]
    },
    "log_level": {
      "default": "info",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "name": {
      "default": "untitled",
      "type": "string"
    },
    "rest": {
      "default": false,
      "type": "boolean"
    },
    "rhi": {
      "default": "null",
      "enum": [
        "null",
        "metal",
        "dx12"
      ]
    },
    "script": {
      "default": "",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "type": "integer"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 720,
          "type": "integer"
        },
        "mode": {
          "default": "windowed",
          "enum": [
            "windowed",
            "fullscreen"
          ]
        },
        "title": {
          "default": "Veach",
          "type": "string"
        },
        "vsync": {
          "default": true,
          "type": "boolean"
        },
        "width": {
          "default": 1280,
          "type": "integer"
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "title": "ProjectConfig",
  "type": "object"
}
