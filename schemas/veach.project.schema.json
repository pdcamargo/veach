{
  "$id": "veach.project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Veach project file (veach.project.json). Generated by `veach schemas` from reflection.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dev_scripts": {
      "default": [],
      "description": "Scripts run after the startup script, in order, in every run: development tools that work on any scene, such as a fly camera.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "frames": {
      "default": 0,
      "type": "integer"
    },
    "frames_in_flight": {
      "default": 2,
      "type": "integer"
    },
    "headless": {
      "default": false,
      "type": "boolean"
    },
    "hot_reload": {
      "default": true,
      "type": "boolean"
    },
    "input": {
      "additionalProperties": {
        "items": {
          "enum": [
            "a",
            "b",
            "c",
            "d",
            "e",
            "f",
            "g",
            "h",
            "i",
            "j",
            "k",
            "l",
            "m",
            "n",
            "o",
            "p",
            "q",
            "r",
            "s",
            "t",
            "u",
            "v",
            "w",
            "x",
            "y",
            "z",
            "digit0",
            "digit1",
            "digit2",
            "digit3",
            "digit4",
            "digit5",
            "digit6",
            "digit7",
            "digit8",
            "digit9",
            "space",
            "enter",
            "escape",
            "tab",
            "backspace",
            "left",
            "right",
            "up",
            "down",
            "left_shift",
            "right_shift",
            "left_ctrl",
            "right_ctrl",
            "left_alt",
            "right_alt",
            "f1",
            "f2",
            "f3",
            "f4",
            "f5",
            "f6",
            "f7",
            "f8",
            "f9",
            "f10",
            "f11",
            "f12",
            "mouse_left",
            "mouse_right",
            "mouse_middle"
          ]
        },
        "maxItems": 2,
        "minItems": 1,
        "type": "array"
      },
      "default": {},
      "description": "Input actions: each action name maps to one or two keys (docs/specs/input/spec.md).",
      "type": "object"
    },
    "log_format": {
      "default": "human",
      "enum": [
        "human",
        "json"
      ]
    },
    "log_level": {
      "default": "info",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "name": {
      "default": "untitled",
      "type": "string"
    },
    "rest": {
      "default": false,
      "type": "boolean"
    },
    "rhi": {
      "default": "null",
      "enum": [
        "null",
        "metal",
        "dx12"
      ]
    },
    "script": {
      "default": "",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "type": "integer"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 720,
          "type": "integer"
        },
        "mode": {
          "default": "windowed",
          "enum": [
            "windowed",
            "fullscreen"
          ]
        },
        "title": {
          "default": "Veach",
          "type": "string"
        },
        "vsync": {
          "default": true,
          "type": "boolean"
        },
        "width": {
          "default": 1280,
          "type": "integer"
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "title": "ProjectConfig",
  "type": "object"
}
